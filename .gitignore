# GROMACS run-stage output (regenerated by em_SH2.sh/equil_SH2.sh/prod_md_SH2.sh;
# real runs live on /scratch/alpine, not here -- these dirs shouldn't exist in the
# repo at all, but ignore them just in case someone runs a stage locally)
EM/
NVT/
NPT/
prod_md_*/

# GROMACS trajectory/binary run output (large, regeneratable, not source)
*.xtc
*.trr
*.edr
*.cpt
*.tpr
*.dcd
*.err
*.out
# NOTE: .mdp/.top/.itp/.gro are intentionally NOT ignored here, unlike biosensors'
# .gitignore -- those are the actual mdp configs and system topology/coordinates
# this project's work product depends on, not disposable trajectory output.

# Large data outputs
*.dx
*.mol2
*.sdf

# Python artifacts
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# System files
.DS_Store
Thumbs.db

# VS Code settings
.vscode/

# Claude code memory/session state
CLAUDE.md
.claude/

# Large AF3 intermediate cache (MSA/template data, ~11MB, reproducible by rerunning AF3;
# the actual outputs we care about -- model.cif, confidences, ranking_scores.csv -- are kept)
**/output/*/*_data.json

# Same policy for AlphaFold Server (web UI) output dirs, which use a different
# layout (msas/, templates/, *_full_data_N.json) than the output/ dirs above
af3/**/msas/
af3/**/templates/
af3/**/*_full_data_*.json

# packmol scratch working directories
packmol_solv_*/

# grompp auto-generated resolved-parameter dump (byproduct of running grompp locally)
mdout.mdp
